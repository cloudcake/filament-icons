{
  "name": "cloudcake/filament-icons",
  "type": "library",
  "license": "proprietary",
  "description": "Icon library and selector component for Filament.",
  "require": {
    "php": "^8.4",
    "blade-ui-kit/blade-icons": "^1.0",
    "mallardduck/blade-lucide-icons": "^1.0",
    "owenvoke/blade-fontawesome": "^3.0",
    "codeat3/blade-phosphor-icons": "^2.0",
    "codeat3/blade-google-material-design-icons": "^1.0",
    "secondnetwork/blade-tabler-icons": "^3.37"
  },
  "require-dev": {
    "filament/filament": "*"
  },
  "autoload": {
    "psr-4": {
      "Cloudcake\\Components\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cloudcake\\Components\\IconsServiceProvider"
      ]
    }
  }
}
